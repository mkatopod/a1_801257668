CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -I$(CURDIR)/include
OPT_LEVEL ?= O2
LDFLAGS = -lrt
TARGETS = array_max_part1 prefix_sum matrix_multiply merge_sort

all: $(TARGETS)

array_max_part1: src/array_max_part1.c include/timing.h
	$(CC) $(CFLAGS) -$(OPT_LEVEL) src/array_max_part1.c -o array_max_part1 $(LDFLAGS)

prefix_sum: src/prefix_sum.c include/timing.h
	$(CC) $(CFLAGS) -$(OPT_LEVEL) src/prefix_sum.c -o prefix_sum $(LDFLAGS)

matrix_multiply: src/matrix_multiply.c include/timing.h
	$(CC) $(CFLAGS) -$(OPT_LEVEL) src/matrix_multiply.c -o matrix_multiply $(LDFLAGS)

merge_sort: src/merge_sort.c include/timing.h
	$(CC) $(CFLAGS) -$(OPT_LEVEL) src/merge_sort.c -o merge_sort $(LDFLAGS)

clean:
	rm -f $(TARGETS)

.PHONY: all clean

